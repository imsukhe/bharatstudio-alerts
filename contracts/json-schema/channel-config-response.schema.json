{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bharatstudio.invalid/v1/channel-config-response.schema.json",
  "title": "Versioned channel alert configuration response",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "channelId", "version", "values", "effectiveAt"],
  "properties": {
    "$schema": {"type": "string", "format": "uri"},
    "schemaVersion": {"const": "v1"},
