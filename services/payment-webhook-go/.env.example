PAYMENT_ENVIRONMENT=test
PAYMENT_PRIVATE_AUDIENCE=
PAYMENT_DATABASE_URL=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com
ALERT_WORKER_PUMP_URL=
ALERT_WORKER_PUMP_AUDIENCE=
ALERT_WORKER_PRIVATE_AUDIENCE=

# All six values are required before paid-plan checkout is enabled for an
# environment. Keep them in the secret/configuration manager, never in code.
RAZORPAY_PLATFORM_ACCOUNT_REF_TEST=
RAZORPAY_PLAN_PRO_MONTHLY_TEST=
RAZORPAY_PLAN_CREATOR_MONTHLY_TEST=
RAZORPAY_PLAN_STUDIO_MONTHLY_TEST=
RAZORPAY_PLAN_PRO_ANNUAL_TEST=
RAZORPAY_PLAN_CREATOR_ANNUAL_TEST=
RAZORPAY_PLAN_STUDIO_ANNUAL_TEST=

# Use the LIVE-suffixed account and plan identifiers only for live billing.
RAZORPAY_PLATFORM_ACCOUNT_REF_LIVE=
RAZORPAY_PLAN_PRO_MONTHLY_LIVE=
RAZORPAY_PLAN_CREATOR_MONTHLY_LIVE=
RAZORPAY_PLAN_STUDIO_MONTHLY_LIVE=
RAZORPAY_PLAN_PRO_ANNUAL_LIVE=
RAZORPAY_PLAN_CREATOR_ANNUAL_LIVE=
RAZORPAY_PLAN_STUDIO_ANNUAL_LIVE=
