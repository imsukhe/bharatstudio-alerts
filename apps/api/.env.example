NODE_ENV=development
HOST=127.0.0.1
PORT=4100
APP_ORIGIN=http://localhost:3100
API_ORIGIN=http://localhost:4100
# Required for staging/production; never fall back to another database URL.
DATABASE_URL_APP=
# Dedicated non-pooled endpoint for LISTEN/NOTIFY wake-ups only.
DATABASE_URL_DIRECT=
GOOGLE_CLIENT_ID=
# Required for staging/production. Generate a random 32-byte key and encode it as 64 hex characters.
NOTIFICATION_TOKEN_ENCRYPTION_KEY=
