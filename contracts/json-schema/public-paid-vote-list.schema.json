{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bharatstudio.in/contracts/v1/public-paid-vote-list.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "items"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schemaVersion": { "const": "v1" },
    "items": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["definitionId", "label", "options"],
        "properties": {
          "definitionId": { "type": "string", "format": "uuid" },
          "label": { "type": "string", "minLength": 1, "maxLength": 120 },
          "options": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["optionKey", "label"],
              "properties": {
                "optionKey": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[a-z0-9_-]+$" },
                "label": { "type": "string", "minLength": 1, "maxLength": 120 }
              }
            }
          }
        }
      }
    }
  }
}
