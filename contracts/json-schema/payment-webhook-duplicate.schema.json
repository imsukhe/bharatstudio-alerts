{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bharatstudio.invalid/v1/payment-webhook-duplicate.schema.json",
  "title": "Duplicate payment webhook scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "deliveries", "expected"],
  "properties": {
    "$schema": {"type": "string", "format": "uri"},
    "schemaVersion": {"const": "v1"},
    "deliveries": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "payment-webhook-delivery.schema.json"}
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerDeliveryRecords", "financialEffects", "alertEvidenceRecords"],
      "properties": {
        "providerDeliveryRecords": {"const": 1},
        "financialEffects": {"const": 1},
        "alertEvidenceRecords": {"const": 1}
      }
    }
  }
}
